<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NSwag.AspNetCore" Version="14.6.3"/>
        <PackageReference Include="NSwag.MSBuild" Version="14.6.3">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\RedShirt.Adventure.Realm.Character.ActionBar.Core\RedShirt.Adventure.Realm.Character.ActionBar.Core.csproj"/>
        <ProjectReference Include="..\RedShirt.Adventure.Realm.Character.ActionBar.Implementations\RedShirt.Adventure.Realm.Character.ActionBar.Implementations.csproj"/>
        <ProjectReference Include="..\RedShirt.Adventure.Realm.Character.Inventory.Core\RedShirt.Adventure.Realm.Character.Inventory.Core.csproj"/>
        <ProjectReference Include="..\RedShirt.Adventure.Realm.Character.Inventory.Implementations\RedShirt.Adventure.Realm.Character.Inventory.Implementations.csproj"/>
        <ProjectReference Include="..\RedShirt.Adventure.Realm.Character\RedShirt.Adventure.Realm.Character.csproj"/>
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="PostBuildEvent">
        <Exec Command="$(NSwagExe_Net100) run nswag.json /variables:Configuration=$(Configuration)"/>
    </Target>

</Project>
